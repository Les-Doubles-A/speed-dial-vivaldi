{
  "manifest_version": 3,
  "name": "Speed Dial Vivaldi",
  "version": "0.1.1",
  "description": "Page Speed Dial personnalisable basée sur tes signets Vivaldi.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
